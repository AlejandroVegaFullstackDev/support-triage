# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me-local-only

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# LLM provider is picked automatically from whichever key is set.
# No key -> local rule-based classifier (free, used in CI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

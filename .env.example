# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me-local-only

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# LLM provider is picked automatically from whichever key is set:
# ANTHROPIC_API_KEY -> Claude, else OPENAI_API_KEY -> OpenAI, else local rules (free, used in CI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

{
  "name": "tickets-api",
  "version": "0.1.0",
  "private": true,
  "description": "Support ticket API. Publishes ticket events for the triage agent.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
